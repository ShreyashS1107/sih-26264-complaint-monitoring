# ==============================================================================
# Environment Configuration Template — SIH 26264
# Integrated Dashboard for Monitoring and Tracking Institution-Related Complaint Cases
# Team: Matrix Maya
#
# NOTE: This file contains non-secret placeholder variables for future phases.
# No active services or databases are connected in Phase 1.
# Copy this file to '.env.local' or '.env' during future phase setup.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL placeholder)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/aicte_complaints?schema=public"

# Authentication & Session Security (NextAuth / JWT placeholders)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-char-secret-key-here"

# Application Logging Level (debug | info | warn | error)
LOG_LEVEL="info"

# Overlap Detection Algorithm Sensitivity Thresholds (0.0 to 1.0)
OVERLAP_SIMILARITY_THRESHOLD="0.75"
OVERLAP_TEMPORAL_WINDOW_DAYS="180"

# Bureau Notification / Mail Service (Placeholders for future notification features)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="placeholder_user"
SMTP_PASS="placeholder_password"
EMAIL_FROM="notifications@aicte-complaints.gov.in"
