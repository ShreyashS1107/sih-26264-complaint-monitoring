# ==============================================================================
# Environment Configuration Template — SIH 26264
# Integrated Dashboard for Monitoring and Tracking Institution-Related Complaint Cases
# Team: Matrix Maya
#
# NOTE: This file contains non-secret placeholder variables.
# 1. Copy this file to '.env' (which is git-ignored):
#    cp .env.example .env
# 2. Update DATABASE_URL and AUTH_SECRET with your deployment credentials.
# 3. DO NOT commit real secrets, passwords, or credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]&sslmode=require
# Examples:
#   Local Docker: postgresql://postgres:postgres_password@localhost:5432/sih26264_test?schema=public
#   Hosted (Neon / Supabase / Vercel): postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/sih26264_test?schema=public"

# Authentication & Session Security (Required in Production)
# Minimum 16 characters. Generate via: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-32-char-secret-key-here"
NEXTAUTH_SECRET="generate-a-secure-random-32-char-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Application Logging Level (debug | info | warn | error)
LOG_LEVEL="info"

# Overlap Detection Algorithm Sensitivity Thresholds (0.0 to 1.0)
OVERLAP_SIMILARITY_THRESHOLD="0.75"
OVERLAP_TEMPORAL_WINDOW_DAYS="180"

# Local Docker Development (Only used by docker-compose.yml for local testing)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="sih26264_test"
POSTGRES_PORT=5432

# Bureau Notification / Mail Service (Optional placeholders)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="placeholder_user"
SMTP_PASS="placeholder_password"
EMAIL_FROM="notifications@aicte-complaints.gov.in"
